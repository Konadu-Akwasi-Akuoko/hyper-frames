{
  "name": "audio-editor",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c blue,green \"bun run dev:vite\" \"bun run dev:api\"",
    "dev:vite": "vite",
    "dev:api": "bun --hot server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "hono": "^4.12.19",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "wavesurfer.js": "^7.12.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
