node_modules/
.DS_Store
__pycache__/
*.pyc
.venv/

# ElevenLabs API key (loaded by tools/voiceover-elevenlabs)
.env

# Superpowers brainstorming visual companion sessions
.superpowers/

# Claude Code scheduled task runtime lock
.claude/scheduled_tasks.lock

# HyperFrames build caches (generated per-video, not source)
.hyperframes/
.thumbnails/

# Rendered video output (large binaries; render locally, don't commit)
renders/

# Talking-head video sources (large binaries, regenerable; don't commit).
# b-roll/ holds raw downloaded stock footage; talking-head.mp4 is the muted
# picture layer derived from the cut master by tools/derive-streams. Both
# routinely exceed GitHub's 100MB per-file limit. The audio (voiceover.mp3,
# raw.mp3) stays tracked.
videos/*/assets/video/b-roll/
videos/*/assets/video/talking-head.mp4

# Shorts rendered video output (per-short out/ holds the large MP4 + cover; render locally)
videos/*/shorts/*/out/

# Baked music bed (large WAV output; regenerate via audio-bed-music)
**/audio/music-bed.wav

# Throwaway staging for batch jobs (motion-inspo scans, candidate beats, proxies)
scratch/

# Thumbnail/title corpus study (2026-06-09): exclude copyrighted competitor
# imagery and superseded prototypes; keep only the text evidence
# (ANALYSIS.md, the gather/contact scripts, per-channel titles.jsonl).
# research/thumbnail-title-corpus-2026-06-09/**/*.png
# research/thumbnail-title-corpus-2026-06-09/**/*.jpg
# research/thumbnail-title-corpus-2026-06-09/**/*.jpeg
# research/thumbnail-title-corpus-2026-06-09/**/*.webp
# research/thumbnail-title-corpus-2026-06-09/**/thumbs/
# research/thumbnail-title-corpus-2026-06-09/signature-specimen/
